# Supabase project settings — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the deployed app (used in auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment provider: "sandbox" simulates a gateway in test mode.
# Real gateways (stripe, razorpay, paypal) register in lib/payments/index.ts.
PAYMENT_PROVIDER=sandbox

# Email provider: "console" logs messages instead of sending them.
EMAIL_PROVIDER=console

# Google AI Studio key (free tier) — powers semantic search, summaries,
# RAG chat, study tools, and recommendations. https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
